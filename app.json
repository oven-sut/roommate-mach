{
  "expo": {
    "name": "Roommate Match",
    "slug": "roommate-mach",
    "scheme": [
      "roomiematch",
      "com.ovensut.roommatemach"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ovensut.roommatemach",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Roommate Match uses your local network to connect to the Expo development server."
      }
    },
    "android": {
      "package": "com.ovensut.roommatemach",
      "adaptiveIcon": {
        "backgroundColor": "#FCF8F6",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Roommate Match needs access to your photos so you can upload your student ID and profile pictures.",
          "cameraPermission": "Roommate Match needs access to your camera so you can take student ID and profile pictures.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "color": "#8F1938"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "1f7abbc0-f36a-4d74-8810-577234043c00"
      }
    }
  }
}
