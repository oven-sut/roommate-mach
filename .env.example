# The deployed API. Point this at a local backend while developing against one:
# a physical phone needs your computer's LAN IP, e.g. http://192.168.1.20:18888,
# not localhost (which on a phone means the phone).
EXPO_PUBLIC_API_URL=https://roommate-mach-be.vercel.app

# Create OAuth 2.0 client IDs in Google Cloud Console for each platform.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
